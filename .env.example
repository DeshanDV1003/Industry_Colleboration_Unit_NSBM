# Copy to .env (never commit .env) and fill in every value. Used by docker-compose.yml.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, a digit and a symbol.
DB_PASSWORD=

# Token signing key: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The first Unit admin, created only when the database has no admin. Remove these after the first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=

# Optional: enables the AI interviewer. Leave empty to keep it switched off.
ANTHROPIC_API_KEY=

# E-mail: Off (default) or Smtp. PUBLIC_URL is the address people open (links in e-mails start with it).
EMAIL_MODE=Off
PUBLIC_URL=https://icu.nsbm.ac.lk
EMAIL_FROM=no-reply@nsbm.ac.lk
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# true only for a public demo with fictional data (demo accounts, sample records, demo reset).
DEMO_MODE=false

# Port the web app is published on.
WEB_PORT=8080
