# API origin. Leave empty in development: Vite proxies /api to the API (see vite.config.ts).
VITE_API_URL=

# Shows one-click demo portal access on the login page and the demo role switcher in the sidebar.
VITE_DEMO_MODE=true

# Camera coaching face model. Empty = Google's published MediaPipe model. To self-host, put
# face_landmarker.task in public/mediapipe/ and set /mediapipe/face_landmarker.task here.
VITE_FACE_MODEL_URL=
